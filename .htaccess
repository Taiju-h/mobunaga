DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Persistent short share links; existing files and directories take precedence.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z][a-z0-9]{2,7})$ short-link.php?code=$1 [END]
  # Route existing share URLs before PHP so a metadata failure cannot block them.
  RewriteCond %{QUERY_STRING} (^|&)type=general(&|$)
  RewriteCond %{QUERY_STRING} (^|&)id=([a-z0-9_-]{1,120})(&|$)
  RewriteRule ^share\.php$ /?open=generals&id=%2 [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} (^|&)type=tactic(&|$)
  RewriteCond %{QUERY_STRING} (^|&)id=([a-z0-9_-]{1,120})(&|$)
  RewriteRule ^share\.php$ /?open=tactics&id=%2 [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} (^|&)type=formation(&|$)
  RewriteCond %{QUERY_STRING} (^|&)id=([a-z0-9_-]{1,120})(&|$)
  RewriteRule ^share\.php$ /?open=formations&id=%2 [R=302,L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/details/([a-z0-9_-]+)\.webp$ assets/general-placeholder.php?slug=$1 [L,QSA,NC]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|json|png|jpe?g|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.live\.json$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/javascript text/css text/html image/svg+xml
</IfModule>
